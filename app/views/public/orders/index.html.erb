<h1>注文履歴一覧</h1>


  <table class="table">
    <thead>
      <tr>
        <th>注文日</th>
        <th>配送先</th>
        <th>注文商品</th>
        <th>支払金額</th>
        <th>ステータス</th>
        <th>注文詳細</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= order.created_at.strftime("%Y年%m月%d日 %H:%M") %></td> <!-- 注文日 -->
          <td><%= order.address %></td> 配送先住所
          
          <!-- 注文商品 -->
          <td>
            <% order.order_details.each do |order_detail| %>
              <p><%= order_detail.item.name %> (x<%= order_detail.quantity %>) - <%= number_to_currency(order_detail.total_price) %></p>
            <% end %>
          </td>
          
          <!-- 支払金額 -->
          <td><%= number_to_currency(order.total_payment) %></td>
          
          <!-- ステータス -->
          <td><%= order.status %></td>
          
          <!-- 注文詳細ページへのリンク -->
          <td><%= link_to '詳細', order_path(order), class: 'btn btn-info' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>