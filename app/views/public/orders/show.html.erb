<div class="container">
  <div class="row">
    <div class='col-md-7'>
      <h3>注文履歴詳細</h3>
    </div>
  </div>
  <div class="row">
    <div class='col-md-7'>
      <table class="table table-bordered">
        <h4>注文情報</h4>
          <tr>
            <th>注文日</th>
            <td><%= @order.created_at.strftime("%Y/%m/%d") %></td>
          </tr>
          <tr>
            <th>支払方法</th>
            <td><%= @order.payment_method_i18n %></td>
          </tr>
          <tr>
            <th>配送先</th>
            <td><%= @order.address %></td>
          </tr>
          <tr>
            <th>合計金額</th>
            <td><%= @order.total_payment %></td>
          </tr>
          <tr>
            <th>ステータス</th>
            <td><%= @order.status_i18n %></td>
          </tr>
      </table>
    </div>
    <div class='col-4'>
    <h4>請求情報</h4>
      <table class="table table-bordered">
        <tr>
          <th>商品合計</th>
          <td><%= @order.total_payment %></td>
        </tr>
        <tr>
          <th>配送料</th>
          <td><%= @order.shipping_cost %></td>
        </tr>
        <tr>
          <th>ご請求金額</th>
          <td><%= @order.total_payment + @order.shipping_cost %></td>
        </tr>
      </table>
    </div>
  </div>
  <div class="row">
    <div class='col-md-9'>
      <h4>注文内容</h4>
      <table class="table table-bordered">
        <thead>
          <tr>
            <th>商品名</th>
            <th>単価(税込)</th>
            <th>数量</th>
            <th>小計</th>
          </tr>
        </thead>
        <tbody>
          <% @order.order_details.each do |order_detail| %>
            <tr>
              <td><%= order_detail.item.name %></td>
              <td><%= number_to_currency(order_detail.price) %></td>
              <td><%= order_detail.amount %></td>
              <td><%= number_to_currency(order_detail.order.total_payment) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>