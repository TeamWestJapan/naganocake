<h1>注文情報入力</h1>
<%= form_with model: @order, url: confirm_orders_path, method: :post do |f| %>
  <div>
    <p>支払方法 </p>
    <%= f.radio_button :payment_method, Order.payment_methods.key(0) %>
    <%= f.label :payment_method_credit_card, Order.payment_methods_i18n[:credit_card] %><br>
    <%= f.radio_button :payment_method, Order.payment_methods.key(1) %>
    <%= f.label :payment_method_transfer, Order.payment_methods_i18n[:transfer]%>
  </div>
  <div>
    <p>お届け先</p>
    <%= f.radio_button :address, "own_address", checked: (@order.address == 'own_address') %>
    <%= f.label :address, "ご自身の住所" %><br>
    <%= f.radio_button :address, "saved_address", checked: (@order.address == 'saved_address') %>
    <%= f.label :address, "登録済み住所から選択" %>
    <%= f.select :address_id, options_from_collection_for_select(Address.all, :id, :address_display) %><br>
    <%= f.radio_button :address, "new_address", checked: (@order.address == 'new_address') %>
    <%= f.label :address, "新しいお届け先" %><br>
    <table>
      <tr>
        <td>郵便番号(ハイフンなし)</td>
        <td><%= f.text_field :postal_code %></td>
        <td>住所</td>
        <td><%= f.text_field :address %></td>
        <td>宛名</td>
        <td><%= f.text_field :name %></td>
      </tr>
    </table>
  </div>

  <%= f.submit "確認画面へ進む" %>
<% end %>


