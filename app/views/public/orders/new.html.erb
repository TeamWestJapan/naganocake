<h1>注文情報入力</h1>

<%= form_with model: @order, url: confirm_orders_path,local:true do |f| %>
  <p>支払方法</p>
    <div>
      <%= f.label :payment_method, "支払方法" %><br>
      <%= f.radio_button :payment_method, "credit_card" %>クレジットカード<br>
      <%= f.radio_button :payment_method, "bank_transfer" %>銀行振込
    </div>
  <p>お届け先</p>
  <%= f.label :address, "お届け先" %><br>
  <%= f.radio_button :address, "own_address", checked: (@order.address == 'own_address') %> ご自身の住所<br>
  <%= f.radio_button :address, "saved_address", checked: (@order.address == 'saved_address') %> 登録済み住所から選択<br>
  <%= f.radio_button :address, "new_address", checked: (@order.address == 'new_address') %> 新しいお届け先<br>

  <!-- ご自身の住所を選択した場合 -->
  <div id="own_address_fields" style="<%= 'display: block;' if @order.address == 'own_address' %>">
    <%= f.label :name, "お届け先氏名" %><br>
    <%= f.text_field :name, value: "#{current_customer.last_name} #{current_customer.first_name}", disabled: true %><br>
    <%= f.label :postal_code, "郵便番号" %><br>
    <%= f.text_field :postal_code, value: current_customer.postal_code, disabled: true %><br>
    <%= f.label :address, "住所" %><br>
    <%= f.text_field :address, value: current_customer.address, disabled: true %><br>
  </div>

  <!-- 登録済み住所から選択した場合 -->
  <div id="saved_address_fields" style="<%= 'display: none;' if @order.address != 'saved_address' %>">
    <%= f.label :saved_address, "登録済み住所" %><br>
    <%= f.collection_select :saved_address, @addresses, :id, :address, prompt: "住所を選択" %><br>
  </div>

  <!-- 新しいお届け先を選択した場合 -->
  <div id="new_address_fields" style="<%= 'display: none;' if @order.address != 'new_address' %>">
    <%= f.label :postal_code, "郵便番号" %><br>
    <%= f.text_field :postal_code %><br>
    <%= f.label :address, "住所" %><br>
    <%= f.text_field :address %><br>
    <%= f.label :name, "宛名" %><br>
    <%= f.text_field :name %><br>
  </div>

  <%= f.submit "確認画面へ進む" %>
<% end %>
