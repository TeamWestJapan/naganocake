<div class='container px-5 px-sm-0'>
  <div class='row'>
    <div class='col-md-3'>
      <p>注文情報確認</p>

        <table class='item_table'>
          <tr>
            <td>商品名</td>
            <td>単価(税込)</td>
            <td>数量</td>
            <td>小計</td>
          </tr>
          <%= form_with model: @order do |f| %>
        </table>
        <table class='cost_table'>
            <tr>
              <td>送料</td>
              <td><%= @shippng_cost %></td>
              <td>商品合計<%= @cart_items_price %></td>
              <td>請求金額<%= @total_price %></td>
            </tr>
        </table>

        
        <p>支払方法</p>
          <%= @order.payment_method_i18n %>
        <p>お届け先</p>
        <% if @order_address %>
          <p><%= @order_address %></p>  <!-- 自身の住所 -->
        <% elsif @selected_address %>
          <p><%= @selected_address %></p>  <!-- 保存した住所 -->
        <% elsif @new_address %>
          <%= @new_postal_code %>
          <%= @new_address %>
          <%= @new_name %>
        <% end %>
        <%= f.submit '注文を確定する' %>
        <% end %>

    </div>
  </div>
</div>
