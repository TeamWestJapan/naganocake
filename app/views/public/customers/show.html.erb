<h1>マイページ</h1>
<div>登録情報  <%= link_to "編集する", info_edit_path %></div>
<table>
    <tr>
        <th>氏名</th>
        <th><%= @customer.last_name %></th>
        <th><%= @customer.first_name %></th>
    </tr>
    <tr>
        <th>カナ</th>
        <th><%= @customer.last_name_kana %></th> 
        <th><%= @customer.last_name_kana %></th>
    </tr>
    <tr>
        <th>郵便番号</th>
        <th><%= @customer.postal_code %></th>
    </tr>
    <tr>
        <th>住所</th>
        <th><%= @customer.address %></th>
    </tr>
    <tr>
        <th>電話番号</th>
        <th><%= @customer.telephone_number %></th>
    </tr>
    <tr>
        <th>メールアドレス</th>
        <th><%= @customer.email %></th>
    </tr>
</table>
<div>配送先  <%= link_to "一覧を見る", addresses_path %></div>
<div>注文履歴  <%= link_to "一覧を見る", orders_path %></div>
