<div class="container">
    <div class="row">
        <div class="col-1">
        </div>
        <div class="col-2">
            <p>マイページ</p>
        </div>
    </div>
    <div class="row">
        <div class="col-1">
            <span>登録情報<span> 
        </div>
        <div class="col-2">
            <%= link_to "編集する", info_edit_path, class: "btn btn-success" %>
        </div>
    </div>
    </br>
    <div class="row">
        <table class="table table-bordered">
            <tr>
                <th class="col-3 table-secondary">氏名</th>
                <td class="col"><%= @customer.full_name %></td>
            </tr>
            <tr>
                <th class="col-3 table-secondary">カナ</th>
                <td class="col"><%= @customer.full_name_kana %></td> 
            </tr>
            <tr>
                <th class="col-3 table-secondary">郵便番号</th>
                <td class="col"><%= @customer.postal_code %></td>
            </tr>
            <tr>
                <th class="col-3 table-secondary">住所</th>
                <td class="col"><%= @customer.address %></td>
            </tr>
            <tr>
                <th class="col-3 table-secondary">電話番号</th>
                <td class="col"><%= @customer.telephone_number %></td>
            </tr>
            <tr>
                <th class="col-3 table-secondary">メールアドレス</th>
                <td class="col"><%= @customer.email %></td>
            </tr>
        </table>
    </div>
    <div class="row">
        <div class="col-1">
            <span>配送先</span>
        </div>
        <div class="col">
            <%= link_to "一覧を見る", addresses_path, class: "btn btn-primary" %>
        </div>
    </div>
    </br>
    <div class="row">
        <div class="col-1">
            <span>注文履歴</span>
        </div>
        <div class="col">
            <%= link_to "一覧を見る", orders_path, class: "btn btn-primary" %>
        </div>
    </div>
</div>