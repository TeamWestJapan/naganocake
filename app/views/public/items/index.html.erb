<div class="container">
  <div class="row">
    <div class="col-3">
      <div class="list-group">
        <p>ジャンル検索</p>
        <% @genres.each do |genre| %>
          <div class="list-group-item">
            <%= genre.name %>
          </div>
        <% end %>
      </div>
    </div>


    <div class="col-9">
      <h1 class="mb-4">商品一覧</h1>
      <% @items.each do |item| %>
        <div class>
          <% if item.image.attached? %>
            <%= image_tag item.image, size: "150x150", class: "mb-2" %>
          <% else %>
            <%= image_tag 'no_image', size: "150x150", class: "mb-2" %>
          <% end %>
          <div class="item-name">
            <%= link_to item_path(item.id) do %>
              <%= item.name %>
            <% end %>
          </div>
          <div class="item-price">
            ¥<%= item.price %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>