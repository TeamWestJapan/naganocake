<div class="container">
  <div class="row">
    <div class="col-3 mt-5">
      <div class="list-group">
        <p>ジャンル検索</p>
        <% @genres.each do |genre| %>
          <div class="list-group-item">
            <%= genre.name %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="col-9">
      <h2 class="row mt-4 mb-4">商品一覧</h2>
      <div class="row mt-3">
        <% @items.each do |item| %>
          <div class="col-lg-3">
            <%= link_to item_path(item.id) do %>
              <% if item.image.attached? %>
                <%= image_tag item.image, size: "150x150", class: "mb-2" %>
              <% else %>
                <%= image_tag 'no_image', size: "150x150", class: "mb-2" %>
              <% end %>
            <% end %>
            <div class="item-name">
              <%= item.name %>
            </div>
            <div class="item-price">
              ¥<%= item.price %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="d-flex justify-content-center mt-5">
  <%= paginate @items, theme: 'bootstrap-5' %>
</div>