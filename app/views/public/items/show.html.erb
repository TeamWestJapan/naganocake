<%= image_tag @item.image %>
<h2><%= @item.name %> <br /></h2>
<%= @item.introduction %> <br />
<font size="5">¥<%= (@item.price*1.1).round %></font> <font size="2">（税込）</font>
<%= form_with model: @cart_item do |f| %>
  <%= f.hidden_field :item_id, value: @item.id %>
  <%= f.select :amount, *[1..10], {prompt: "個数選択"} %>
  <%= f.submit "カートに入れる" %>
<% end %>