<h1>ショッピングカート</h1>
<div><%= link_to "カートを空にする", destroy_all_cart_items_path, method: :delete, "data-confirm" => "商品を全て削除しますか？" %></div>
<table>
  <thead>
    <tr>
      <th>商品名</th>
      <th>単価(税込)</th>
      <th>数量</th>
      <th>小計</th>
      <th><br></th>
    </tr>
  </thead>
  <tbody>
  <% @cart_items.each do |cart_item| %>
    <tr>
      <td>
        <%= cart_item.item.name %>
      </td>
      <td>
        <%= (cart_item.item.price * 1.1).floor %>
      </td>
      <td>
        <%= cart_item.amount %>
      </td>
      <td>
        <%= (cart_item.item.price * 1.1).floor * cart_item.amount %>
      </td>
      <td>
        <%= link_to "削除する", cart_item_path(cart_item.id), method: :delete, "data-confirm" => "商品を削除しますか？" %>
      </td>
    </tr>
  <% end %>

    <tr><th>合計金額</th><td>未実装</td></tr>

  </tbody>
</table>
 <%= link_to "買い物を続ける", items_path %>
 <%= link_to "情報入力に進む(仮)", orders_path %>