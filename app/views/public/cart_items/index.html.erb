<h1>ショッピングカート</h1>
<div>カートを空にする機能</div>
<table>
  <thead>
    <tr>
      <th>商品名</th>
      <th>単価(税込)</th>
      <th>数量</th>
      <th>小計</th>
    </tr>
  </thead>
  <tbody>
  <% @cart_items.each do |cart_item| %>
    <tr>
      <td>cart_item.item.name</td>
      <td><%= (cart_item.item.price * 1.1).floor %></td>
      <td>cart_item.amount</td>
      <td><%= (cart_item.item.price * 1.1).floor * cart_item.amount %></td>
      <td>削除する</td>
    </tr>
  <% end %>
  </tbody>
</table>