<div class = "container">
  <div class ="row">
    <div class="col"><h2 class="">ショッピングカート</h2></div>
    <div class="col"></div>
    <div class="col text-right "><%= link_to "カートを空にする", destroy_all_cart_items_path, method: :delete, "data-confirm" => "商品を全て削除しますか？", class: "btn btn-danger" %></div>
  </div>
<br>
  <div class="row">
    <table class="table table-bordered">
      <thead>
        <tr class = "table-secondary">
          <th>商品名</th>
          <th>単価(税込)</th>
          <th>数量</th>
          <th>小計</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @cart_items.each do |cart_item| %>
        <% @total += cart_item.subtotal %>
          <tr>
            <td>
              <% if cart_item.item.image.attached? %>
                <%= image_tag cart_item.item.image, size:"60x50" %>
              <% else %>
                <%= image_tag 'no_image', size:"60x50" %>
              <% end %>
              <%= cart_item.item.name %>
            </td>
            <td>
              ¥<%= cart_item.item.with_tax_price %>
            </td>
            <td>
              <%= form_with model: cart_item, url: cart_item_path(cart_item.id) do |f| %>
                <%= f.select :amount, *[1..10] %>
                <%= f.submit "変更", class: "btn btn-success" %>
              <% end %>
            </td>
            <td>
              ¥<%= cart_item.subtotal %>
            </td>
            <td>
              <%= link_to "削除する", cart_item_path(cart_item.id), method: :delete, "data-confirm" => "商品を削除しますか？", class: "btn btn-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="row">
    <div class="col-8">
      <%= link_to "買い物を続ける", items_path, class: "btn btn-primary" %>
    </div>
    <div class="col-4">
      <table class="table table-bordered">
        <th class="table-secondary">合計金額</th><td>¥<%= @total %></td>
      </table>
    </div>
  </div>

  <div class="row">
    <div class="col"></div>
    <div class="col">
      <%= link_to "情報入力に進む", new_order_path, class: "btn btn-success" %>
    </div>
  </div>
</div>