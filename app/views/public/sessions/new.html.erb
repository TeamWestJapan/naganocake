<div class="container">
  </br>
  <div class="row">
    <div class="col">
      <h4>ログイン</h4>
    </div>
  </div>
  </br>
  <div class="row">
    <div class="col">
      <p>会員の方はこちらからログイン</p>
    </div>
  </div>

  <%= form_with model: @customer, url: customer_session_path do |f| %>
    <div class="row">
      <div class="col-1">
      </div>
      <div class="col-2">
        <%= f.label :email, "メールアドレス" %>
      </div>
      <div class="col">
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "sample@example.com", size: "50x20" %>
      </div>
    </div>
    </br>
    <div class="row">
      <div class="col-1">
      </div>
      <div class="col-2">
        <%= f.label :password, "パスワード" %>
      </div>
      <div class="col">
        <%= f.password_field :password, autocomplete: "current-password", size: "50x20" %>
      </div>
    </div>
    </br>
    <div class="row">
      <div class="col-3">
      </div>
      <div class="col">
        <%= f.submit "ログイン", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="col">
      <p>会員登録がお済みでない方</p>
    </div>
  </div>
  <div class="row">
    <div class="col-1">
    </div>
    <div class="col">
      <%= render "public/shared/links" %>から新規登録を行なってください。
    </div>
  </div>
</div>


