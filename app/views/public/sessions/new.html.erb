<div class="container">
  <div class="row">
    <div class="col">
      <p>ログイン</p>
    </div>
  </div>
  <div class="row">
    <div class="col">
      <p>会員の方はこちらからログイン</p>
    </div>
  </div>

  <%= form_with model: @customer, url: customer_session_path do |f| %>
    <div class="row">
      <div class="col-1">
      </div>
      <div class="col-2">
        <%= f.label :email, "メールアドレス" %>
      </div>
      <div class="col">
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>
    </div>
    </br>
    <div class="row">
      <div class="col-1">
      </div>
      <div class="col-2">
        <%= f.label :password, "パスワード" %>
      </div>
      <div class="col">
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>
    </div>
    </br>
    <div class="row">
      <div class="col-3">
      </div>
      <div class="col">
        <%= f.submit "ログイン" %>
      </div>
    </div>
  <% end %>
</div>
<p>会員登録がお済みでない方</p>
<%= render "public/shared/links" %>から新規登録を行なってください。
