<div class="container">
  <div class="row">
    <h1 class="mb-5">商品編集</h1>
  </div>

  <div class="row">
    <div class="mx-auto">
      <%= form_with model: @item, url: admin_item_path(@item) do |f| %>
        <table class="table table-borderless">
          <tr><th>商品画像</th> <td><%= f.file_field :image, accept: "image/*" %></td></tr>
          <tr><th>商品名</th> <td><%= f.text_field :name %></td></tr>
          <tr><th>商品説明</th> <td><%= f.text_area :introduction %></td></tr>
          <tr><th>ジャンル</th> <td><%= f.collection_select :genre_id, Genre.all, :id, :name, include_blank: "選択してください" %></td></tr>
          <tr><th>税抜価格</th> <td><%= f.text_field :price %>円</td></tr>
          <tr><th>販売ステータス</th>
            <td>
              <%= f.radio_button :is_active, true %>
                <%= f.label :is_active, "販売中" %>
              <%= f.radio_button :is_active, false %>
                <%= f.label :is_active, "販売停止中" %>
            </td>
          </tr>
        </table>
        <div class="d-flex justify-content-center mt-3"><%= f.submit "変更を保存", class: "btn btn-success" %></div>
      <% end %>
    </div>
  </div>
</div>