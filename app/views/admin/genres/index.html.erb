<div class="container">
  <div class="row">
    <h1 class="mb-5">ジャンル一覧・追加</h1>
  </div>

  <div class="row">
    <%= form_with model: @genre, url: admin_genres_path do |f| %>
      <div class="genrename me-5"><%= f.label :name, 'ジャンル名' %></div>
      <div class=""><%= f.text_field :name %>
      <%= f.submit "新規登録" %>
    <% end %>

<table>
  <thead>
    <tr>
      <th>ジャンル</th>
    </tr>
  </thead>
  <tbody>
    <% @genres.each do |genre| %> 
      <tr>
        <td> <%= genre.name %> </td>
        <td> <%= link_to "編集する", edit_admin_genre_path(genre) %> </td>
      </tr>
    <% end %>
  </tbody>
</table>