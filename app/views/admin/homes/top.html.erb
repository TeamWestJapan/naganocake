<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-9">
      <table class="table">
        <h2>注文履歴一覧　</h2>
          <thead>
            <tr>
              <th>購入日時</th>
              <th>購入者</th>
              <th>注文個数</th>
              <th>注文ステータス</th>
            </tr>
          </thead>
          <tbody>
            <% @orders.each do |order| %>
              <tr>
                <td><%= order.created_at.strftime("%Y/%m/%d %H:%M") %></td>
                <td><%= order.customer.last_name %><%= order.customer.first_name %></td>
                <td><%= order.order_details.sum(:amount) %></td>
                <td><%= order.status_i18n %></td>
              </tr>
            <% end %>
          </tbody>
      </table>
      <div class= "row justify-content-center" >
        <div class= "pagination" >
          <%= paginate @orders,
          next_label: 'Next　&raquo;'.html_safe,
          first_label: '<<First'.html_safe,
          last_label: 'Last>>'.html_safe,
          outer_window: 2,
          inner_window: 2,
          param_name: :page %>
        </div>
      </div>
    </div>
  </div>
</div>