<h2>注文履歴詳細</h2>

<table>
  <tr>
    <th>購入者</th>
    <th>
      <%= link_to admin_customer_path(@order) do %>
        <%= @order.customer.last_name %> <%= @order.customer.first_name %>
      <% end %>
    </th>
  </tr>
  <tr>
    <th>注文日</th>
    <th><%= @order.created_at.strftime('%Y/%m/%d') %></th>
  </tr>
  <tr>
    <th>配送先</th>
    <th>
      〒<%= @order.postal_code %><%= @order.address %></br>
      <%= @order.name %>
    </th>
  </tr>
  <tr>
    <th>支払方法</th>
    <th><%= @order.payment_method_i18n %></th>
  </tr>
  <tr>
    <th>注文ステータス</th>
    <th>
      <%= form_with model: @order, url: admin_order_path(@order), method: :patch do |f| %>
        <%#= f.select :status, options_for_select(Order.statuses) %>
        <%#= f.select :status, Order.statuses.map {|k,v| [t("enums.order.status.#{k}"), v]} %>
        <%= f.select :status, Order.statuses.keys.map {|k| [t("enums.order.status.#{k}"), k]} %>
        <%= f.submit "更新" %>
      <% end %>
    </th>
  </tr>
</table>

<table>
  <thead>
    <tr>
      <th>商品名</th>
      <th>単価(税込)</th>
      <th>数量</th>
      <th>小計</th>
      <th>製作ステータス</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <th><%= @order_detail.item.name %></th> 
      <th><%= @order_detail.price %></th>
      <th><%= @order_detail.amount %></th>
      <th><%= @order_detail.price * @order_detail.amount %></th>
      <%= form_with model: [@order, @order_detail], url: admin_order_order_detail_path(@order.id, @order_detail), method: :patch  do |f| %>
        <th><%= f.select :making_status, OrderDetail.making_statuses.keys.map{|k| [t("enums.order_detail.making_status.#{k}"), k]} %></th>
        <th><%= f.submit "更新" %></th>
      <% end %>
    </tr>
  </tbody>
</table>


